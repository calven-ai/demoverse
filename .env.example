# =============================================================================
# Synthetic Demo-World Engine: credentials
# Copy to `.env` (gitignored) and fill in. The guides in docs/connectors/ show
# how to get each value. Every connector no-ops cleanly when its variables are absent, so
# the deterministic half of the engine runs with none of these set. All systems
# live in DEDICATED, ISOLATED orgs/workspaces you are authorized to use. Never
# point this at a real production system.
# =============================================================================

# --- Salesforce (Developer Edition) ------------------------------------------
# SOAP username/password + security-token login (no Connected App needed).
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# --- HubSpot (dedicated connector-test account) ------------------------------
# A private-app access token used only by `hubspot:setup` / `hubspot:import` /
# `hubspot:verify` / `hubspot:purge` to seed and inspect a dedicated CRM sample.
# Do not point this at a production HubSpot account.
# Required scopes: crm.objects.{companies,contacts,deals}.{read,write} and
# crm.schemas.{companies,contacts,deals}.{read,write}.
HUBSPOT_ACCESS_TOKEN=
# Optional test override; normally leave this unchanged.
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# --- Google Drive (service account) ------------------------------------------
# Path to the downloaded service-account JSON key, and the id of the shared
# demo folder (the folder must be shared with the service-account email).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
DRIVE_ROOT_FOLDER_ID=

# --- Slack (dedicated free demo workspace) -----------------------------------
# Bot token (xoxb-...) for the single controller app. Requires scopes:
# chat:write, chat:write.customize, channels:read, channels:join,
# channels:manage, reactions:write.
SLACK_BOT_TOKEN=
